# MySQL configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=skill_swap

# Server
PORT=5000

# Authentication token signing secret
# Use a long random value outside local development.
AUTH_SECRET=change-this-to-a-long-random-secret

# Optional comma-separated browser origins for development/deployment
CORS_ORIGIN=http://localhost:5000,http://localhost:5500
